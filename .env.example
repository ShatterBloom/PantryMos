# Local development defaults. Copy to .env and adjust.

# Postgres superuser (bootstrap + migrations only)
PG_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres

# Per-service roles (created by `pnpm db:bootstrap`)
PANTRY_MCP_PASSWORD=dev-mcp-password
PANTRY_AGENT_PASSWORD=dev-agent-password
PANTRY_DB_NAME=pantrymos

# mcp-server
MCP_DATABASE_URL=postgres://pantry_mcp:dev-mcp-password@127.0.0.1:5432/pantrymos
MCP_BIND_HOST=127.0.0.1
MCP_PORT=7410
INTERNAL_PORT=7411
SERVICE_TOKEN=dev-service-token-change-me
MCP_ALLOWED_ORIGINS=
ALLOW_ANON_WRITES=0

# agent
AGENT_DATABASE_URL=postgres://pantry_agent:dev-agent-password@127.0.0.1:5432/pantrymos
AGENT_BIND_HOST=127.0.0.1
AGENT_PORT=7400
AGENT_MCP_URL=http://127.0.0.1:7410/mcp
AGENT_INTERNAL_URL=http://127.0.0.1:7411
AGENT_MCP_TOKEN=dev-agent-mcp-token-change-me
# The household AGENT_MCP_TOKEN belongs to (the seeded demo household).
AGENT_HOUSEHOLD_ID=00000000-0000-4000-8000-000000000001
# Origins allowed to make state-changing /api requests (comma-separated).
AGENT_APP_ORIGINS=http://localhost:7400,http://127.0.0.1:7400,http://localhost:5173,http://127.0.0.1:5173
# Signs the web app's session cookie (at least 32 characters).
AGENT_SESSION_SECRET=dev-session-secret-change-me-0123456789
# Unset: anyone who reaches the app is signed in as the demo user, which is safe only while the
# agent is published to the host's loopback alone. Set a passcode (and AGENT_SECURE_COOKIE=true
# behind HTTPS) when deployed.
AGENT_PASSCODE=

# Amazon Nova via the Bedrock Converse API. Credentials come from the default AWS chain;
# AWS_PROFILE names a profile in ~/.aws, which docker compose mounts read-only into the agent.
AWS_PROFILE=pantrymos-bedrock
BEDROCK_REGION=ap-southeast-2
BEDROCK_MODEL_ID=apac.amazon.nova-pro-v1:0
